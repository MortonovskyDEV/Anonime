<Window x:Class="GothMessenger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:GothMessenger"
        mc:Ignorable="d"
        Title="GothMessenger" 
        Height="800" 
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource GothWindowStyle}">
    
    <Window.Resources>
        <!-- Темная тема -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Сайдбар -->
        <Border Grid.Column="0" 
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,1,0">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Заголовок -->
                <Border Grid.Row="0" 
                        Background="{StaticResource PrimaryGradient}"
                        Height="70"
                        Padding="20">
                    <StackPanel Orientation="Horizontal" 
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Ghost" 
                                                Width="32" 
                                                Height="32"
                                                Foreground="White"/>
                        <TextBlock Text="GothMessenger"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Поиск -->
                <Border Grid.Row="1" 
                        Padding="15"
                        Background="Transparent">
                    <materialDesign:TextBox 
                        materialDesign:HintAssist.Hint="Поиск чатов..."
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Foreground="{StaticResource TextPrimary}"
                        FontSize="14">
                        <materialDesign:TextFieldAssist.DecorationVisibility>Visible</materialDesign:TextFieldAssist.DecorationVisibility>
                        <materialDesign:TextFieldAssist.HasClearButton>True</materialDesign:TextFieldAssist.HasClearButton>
                        <materialDesign:TextFieldAssist.LeadingIcon>
                            <materialDesign:PackIcon Kind="Magnify" 
                                                    Foreground="{StaticResource TextSecondary}"/>
                        </materialDesign:TextFieldAssist.LeadingIcon>
                    </materialDesign:TextBox>
                </Border>
                
                <!-- Список чатов -->
                <ScrollViewer Grid.Row="2" 
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,5,0">
                    <ItemsControl x:Name="ChatsList"
                                  ItemsSource="{Binding Chats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        Margin="10,2"
                                        CornerRadius="8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ItemSelectedBackground}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ItemHoverBackground}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <Grid Margin="12" 
                                          Height="70">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Аватар -->
                                        <Border Grid.Column="0"
                                                Width="48"
                                                Height="48"
                                                CornerRadius="24"
                                                Background="{StaticResource AvatarBackground}">
                                            <Image Source="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatar}}"
                                                   Stretch="UniformToFill"/>
                                            
                                            <!-- Онлайн статус -->
                                            <Border Width="12"
                                                    Height="12"
                                                    CornerRadius="6"
                                                    BorderThickness="2"
                                                    BorderBrush="{StaticResource SidebarBackground}"
                                                    Background="{Binding StatusColor}"
                                                    VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Right"/>
                                        </Border>
                                        
                                        <!-- Информация о чате -->
                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                      FontWeight="SemiBold"
                                                      FontSize="14"
                                                      Foreground="{StaticResource TextPrimary}"
                                                      TextTrimming="CharacterEllipsis"/>
                                            
                                            <TextBlock Text="{Binding LastMessage}"
                                                      FontSize="12"
                                                      Foreground="{StaticResource TextSecondary}"
                                                      TextTrimming="CharacterEllipsis"
                                                      Margin="0,4,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- Время и бейдж -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding LastMessageTime}"
                                                      FontSize="11"
                                                      Foreground="{StaticResource TextSecondary}"/>
                                            
                                            <Border Visibility="{Binding UnreadCount, Converter={StaticResource VisibilityConverter}}"
                                                    Background="{StaticResource PrimaryColor}"
                                                    CornerRadius="10"
                                                    Margin="0,4,0,0"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding UnreadCount}"
                                                          FontSize="10"
                                                          FontWeight="Bold"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
                <!-- Профиль пользователя -->
                <Border Grid.Row="3"
                        Background="{StaticResource ItemSelectedBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Height="70"
                        Cursor="Hand">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Аватар пользователя -->
                        <Border Grid.Column="0"
                                Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{StaticResource PrimaryGradient}">
                            <TextBlock Text="{Binding CurrentUser.Initials}"
                                      Foreground="White"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Информация -->
                        <StackPanel Grid.Column="1"
                                    Margin="12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.Username}"
                                      FontWeight="SemiBold"
                                      FontSize="14"
                                      Foreground="{StaticResource TextPrimary}"/>
                            
                            <TextBlock Text="{Binding CurrentUser.Status}"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        
                        <!-- Действия -->
                        <materialDesign:PopupBox Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MaterialDesignMultiFloatingActionPopupBox}">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Kind="DotsVertical" 
                                                        Foreground="{StaticResource TextSecondary}"/>
                            </materialDesign:PopupBox.ToggleContent>
                            
                            <StackPanel>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Настройки"
                                        Command="{Binding OpenSettingsCommand}"/>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Выйти"
                                        Command="{Binding LogoutCommand}"/>
                            </StackPanel>
                        </materialDesign:PopupBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
        <!-- Основная область -->
        <Grid Grid.Column="1"
              Background="{StaticResource MainBackground}">
            
            <!-- Заголовок чата -->
            <Border Height="70"
                    Background="{StaticResource ChatHeaderBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Информация о чате -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="20,0">
                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{StaticResource AvatarBackground}"
                                Margin="0,0,12,0">
                            <Image Source="{Binding CurrentChat.AvatarUrl, FallbackValue={StaticResource DefaultAvatar}}"
                                   Stretch="UniformToFill"/>
                        </Border>
                        
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentChat.Name}"
                                      FontSize="16"
                                      FontWeight="SemiBold"
                                      Foreground="{StaticResource TextPrimary}"/>
                            
                            <TextBlock Text="{Binding CurrentChat.StatusText}"
                                      FontSize="12"
                                      Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Действия -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Margin="0,0,20,0">
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Голосовой звонок"
                                Command="{Binding StartVoiceCallCommand}">
                            <materialDesign:PackIcon Kind="Phone" 
                                                    Width="20" 
                                                    Height="20"/>
                        </Button>
                        
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Видеозвонок"
                                Command="{Binding StartVideoCallCommand}">
                            <materialDesign:PackIcon Kind="Video" 
                                                    Width="20" 
                                                    Height="20"/>
                        </Button>
                        
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Информация о чате"
                                Command="{Binding ShowChatInfoCommand}">
                            <materialDesign:PackIcon Kind="Information" 
                                                    Width="20" 
                                                    Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Сообщения -->
            <ScrollViewer x:Name="MessagesScrollViewer"
                          Margin="0,70,0,80"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:MessageControl DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <!-- Ввод сообщения -->
            <Border Height="80"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource MessageInputBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Дополнительные кнопки -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Прикрепить файл"
                                Command="{Binding AttachFileCommand}">
                            <materialDesign:PackIcon Kind="Paperclip" 
                                                    Width="20" 
                                                    Height="20"/>
                        </Button>
                        
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Эмодзи"
                                Command="{Binding ShowEmojiCommand}">
                            <materialDesign:PackIcon Kind="EmoticonHappy" 
                                                    Width="20" 
                                                    Height="20"/>
                        </Button>
                    </StackPanel>
                    
                    <!-- Поле ввода -->
                    <materialDesign:TextBox Grid.Column="1"
                                           Margin="12,0"
                                           materialDesign:HintAssist.Hint="Введите сообщение..."
                                           Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                           Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                           AcceptsReturn="True"
                                           VerticalAlignment="Center"
                                           VerticalScrollBarVisibility="Auto"
                                           MaxHeight="120"
                                           FontSize="14">
                        <materialDesign:TextBox.InputBindings>
                            <KeyBinding Key="Enter" 
                                       Command="{Binding SendMessageCommand}"/>
                        </materialDesign:TextBox.InputBindings>
                    </materialDesign:TextBox>
                    
                    <!-- Кнопка отправки -->
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="40"
                            Height="40"
                            Command="{Binding SendMessageCommand}"
                            ToolTip="Отправить сообщение (Enter)">
                        <materialDesign:PackIcon Kind="Send" 
                                                Width="20" 
                                                Height="20"
                                                Foreground="White"/>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Индикатор печати -->
            <TextBlock Text="{Binding TypingIndicator}"
                      FontSize="12"
                      Foreground="{StaticResource TextSecondary}"
                      Margin="20,0,0,0"
                      VerticalAlignment="Bottom"
                      Height="20"/>
        </Grid>
        
        <!-- Видеозвонок -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsInCall, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="Black">
            
            <!-- Удалённое видео -->
            <Border x:Name="RemoteVideoContainer"
                    Background="{StaticResource DarkBackground}">
                <!-- WebRTC видео будет здесь -->
            </Border>
            
            <!-- Локальное видео -->
            <Border x:Name="LocalVideoContainer"
                    Width="240"
                    Height="135"
                    CornerRadius="8"
                    Background="{StaticResource DarkBackground}"
                    BorderBrush="White"
                    BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20,100,20,0">
                <!-- WebRTC видео будет здесь -->
            </Border>
            
            <!-- Панель управления -->
            <Border Background="#80000000"
                    VerticalAlignment="Bottom"
                    Height="100">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    
                    <Button Style="{StaticResource CallControlButtonStyle}"
                            Command="{Binding ToggleMicrophoneCommand}">
                        <materialDesign:PackIcon Kind="{Binding MicrophoneIcon}" 
                                                Width="24" 
                                                Height="24"
                                                Foreground="White"/>
                    </Button>
                    
                    <Button Style="{StaticResource CallControlButtonStyle}"
                            Command="{Binding ToggleCameraCommand}">
                        <materialDesign:PackIcon Kind="{Binding CameraIcon}" 
                                                Width="24" 
                                                Height="24"
                                                Foreground="White"/>
                    </Button>
                    
                    <Button Style="{StaticResource CallControlButtonStyle}"
                            Command="{Binding ToggleSpeakerCommand}">
                        <materialDesign:PackIcon Kind="{Binding SpeakerIcon}" 
                                                Width="24" 
                                                Height="24"
                                                Foreground="White"/>
                    </Button>
                    
                    <Button Style="{StaticResource EndCallButtonStyle}"
                            Command="{Binding EndCallCommand}">
                        <materialDesign:PackIcon Kind="PhoneHangup" 
                                                Width="24" 
                                                Height="24"
                                                Foreground="White"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Информация о звонке -->
            <Border Background="#80000000"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,40,0,0"
                    Padding="20,10">
                <StackPanel>
                    <TextBlock Text="{Binding CallParticipantName}"
                              Foreground="White"
                              FontSize="18"
                              FontWeight="Bold"
                              HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="{Binding CallDuration}"
                              Foreground="#CCCCCC"
                              FontSize="14"
                              Margin="0,4,0,0"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>